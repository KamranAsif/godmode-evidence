  "isolation": [
    {
      "suspect": "Cascade swimming",
      "observation": "Engine already snaps each cascade; changing splits or removing blending did not remove underside speckling."
    },
    {
      "suspect": "200 m pancake/depth precision",
      "observation": "24 m and 0 m did not remove it. Speckling persists with sun shadows disabled; approved 200 m retained."
    },
    {
      "suspect": "PCSS noise/thin cable casters",
      "observation": "Hard shadows, ultra samples and disabled cable shadow casting did not resolve the deck effect; all casters retained."
    },
    {
      "suspect": "SSAO",
      "observation": "Disabling SSAO removes the unstable dark contact bands but also loses the approved look. Full-resolution SSAO steadies them and preserves contacts."
    },
    {
      "suspect": "SSIL",
      "observation": "Disabling SSIL alone did not resolve the effect; retained."
    },
    {
      "suspect": "Bias",
      "observation": "Depth bias 0.15 and normal bias 3 did not remove the effect; original values retained."
    },
    {
      "suspect": "Bridge treatment",
      "observation": "Removing contrast/underside treatment changes the look but leaves speckling; approved values retained."
    },
    {
      "suspect": "Subpixel edges",
      "observation": "TAA steadies thin steel/cable edges more effectively than 4x MSAA or additional PCSS samples."
    }
  ],
