    "nativeBakeEngine": {
      "usage": "Attempted bake engine; does not contribute to the realtime champion.",
      "version": "Godot 4.6.1 stable",
      "commit": "14d19694e0c88a3f9e82d899a0400f27a24c176e",
      "patchSha256": "e53d70f1e70de41fba259aabb5800b898875e7a1d6d03d222cc0abcde938efc3",
      "change": "Split vertex storage into buffers of at most 1 GiB, translate original indices in shaders, correct partial triangle-cluster bounds, use triangle derivatives for texel footprints, avoid singular downward-normal tangent bases, and bound unocclusion and indirect-light dispatches. Direct lighting preserves full-precision per-light AA sums and RNG state across sixteen submissions; empty atlas tiles are skipped. A stackless hierarchy over the original sorted clusters prunes missed subtrees while preserving leaf and triangle order. Geometry, quality, ray counts and probe ray counts are unchanged.",
      "performance": {
        "vertexBufferChunkBytes": 1073741824,
        "gridSize": 128,
        "regionSize": 64,
        "directRegionSize": 32,
        "directAaPasses": 16,
        "directAccumulator": "float32 color, shadow and uint32 RNG per light",
        "occupancyTileSize": 16,
        "clusterTraversal": "stackless BVH over original sorted leaf clusters",
        "indirectRegionSize": 16,
        "raysPerPass": 4,
        "probeRaysPerPass": 16
      }
    },
    "geometry": "Same frozen 90m camera-union crop; static expansion of MultiMesh, no automatic LODs; custom AO restored after UV2 unwrap. Oversized UV2 layouts are subdivided without changing triangles or pixel density. Allocation split into batches at exact receiver UV2 density; every batch retains full-precision occluding geometry with coarse discarded albedo-only charts for other batches.",
    "timing": "3s warmup + 3s window per camera. Crop measurements, not full-map production benchmarks. Shared GPU; other lanes may render between bakes. Peer inventory is recorded with each candidate.",
    "indirectEnergy": "LightmapGI.bounce_indirect_energy; final sun light_indirect_energy remains 1.",
